# JobPilot Production Environment Variables
# Copy to .env for production deployment

# Database
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=change-me-to-strong-password
POSTGRES_DB=jobpilot

# Backend
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
COHERE_API_KEY=your-cohere-api-key
TAVILY_API_KEY=your-tavily-api-key
SERPER_API_KEY=your-serper-api-key
JWT_SECRET_KEY=generate-a-32-char-min-secret-here

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-32-char-min-secret-here