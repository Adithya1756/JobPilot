# JobPilot Backend Environment Variables (Simplified - Gemini Free Tier)
# Copy this file to .env and fill in your values

# Database (PostgreSQL with pgvector)
# For local development with docker-compose:
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot_dev_password@localhost:5432/jobpilot
# For Neon (production):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/jobpilot?sslmode=require

# Auth
JWT_SECRET_KEY=change-me-in-production-min-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini API (FREE tier - no credit card required)
# Get your key at: https://aistudio.google.com/apikey
# Models used: gemini-3.5-flash (LLM), gemini-embedding-001 (embeddings)
GEMINI_API_KEY=your-gemini-api-key

# File Storage (local for dev, S3-compatible for production)
# For local dev, files are stored in UPLOAD_DIR
UPLOAD_DIR=uploads
# For production, use AWS S3 or Supabase Storage:
# S3_BUCKET=jobpilot-uploads
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT=https://your-bucket.s3.amazonaws.com

# Redis (for background tasks - optional)
REDIS_URL=redis://localhost:6379/0

# App
APP_NAME=JobPilot API
DEBUG=false