# JobPilot Backend Environment Variables
# Copy this file to .env and fill in your values

# Database (PostgreSQL with pgvector)
# For local development with docker-compose:
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot_dev_password@localhost:5432/jobpilot
# For Neon (production):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/jobpilot?sslmode=require

# Auth
JWT_SECRET_KEY=change-me-in-production-min-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM APIs
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Reranking (Cohere) - Optional but recommended for better retrieval precision
# Get your key at: https://dashboard.cohere.com/
COHERE_API_KEY=your-cohere-api-key

# Web Search APIs - Optional, used for company research in cover letters
# Tavily (recommended for AI agents): https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key
# Serper (Google Search API): https://serper.dev/
SERPER_API_KEY=your-serper-api-key

# File Storage (S3-compatible)
# For local dev, files are stored locally
# For production, use AWS S3 or Supabase Storage
# S3_BUCKET=jobpilot-uploads
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT=https://your-bucket.s3.amazonaws.com

# Redis (for background tasks)
REDIS_URL=redis://localhost:6379/0

# Google Calendar API - Optional, for calendar integration
# Create OAuth2 credentials at: https://console.cloud.google.com/apis/credentials
# Enable Google Calendar API in your project
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# After OAuth flow, you'll get a refresh token - store it here
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# App
APP_NAME=JobPilot API
DEBUG=false
